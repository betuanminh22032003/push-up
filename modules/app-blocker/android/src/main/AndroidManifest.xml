<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!--
    For the way of blocking that banking apps accept (WatchService): usage
    access to see which app is in front, which the user grants in settings;
    "display over other apps" to open the block screen from the background
    and draw the countdown; a foreground service to keep watching, restarted
    after a reboot or an update.
  -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    Package visibility on Android 11+, without the QUERY_ALL_PACKAGES
    permission that Google Play restricts: launchable apps for the picker,
    browsers for site blocking, and the home screen, Settings and the dialer so
    they can never be blocked.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <intent>
      <action android:name="android.settings.SETTINGS" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DIAL" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <!--
    The blocker runs in its own small process, ":blocker", away from the React
    Native one (JS engine, camera, WebView). That big process is what the
    system reclaims for memory and what a JS crash kills; sharing it, the
    service died too, and on realme was then not restarted.
  -->
  <application>
    <!--
      Only the system can bind a service guarded by BIND_ACCESSIBILITY_SERVICE,
      so exporting it exposes nothing to other apps.
    -->
    <service
      android:name="expo.modules.appblocker.BlockerService"
      android:exported="true"
      android:label="@string/app_blocker_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:process=":blocker">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/app_blocker_service" />
    </service>

    <!--
      Blocks apps without the accessibility service, which many banking apps
      refuse to run next to. It waits while that service is on.
    -->
    <service
      android:name="expo.modules.appblocker.WatchService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:process=":blocker">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="App blocker: watches which app is in front to block the apps the user chose until they earn time with push-ups" />
    </service>

    <receiver
      android:name="expo.modules.appblocker.BootReceiver"
      android:exported="false"
      android:process=":blocker">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- The one copy of the blocker's state, which the JS module reaches from the main process. -->
    <provider
      android:name="expo.modules.appblocker.BlockerProvider"
      android:authorities="${applicationId}.appblocker"
      android:exported="false"
      android:process=":blocker" />

    <!--
      Its own task, kept out of Recents: the block screen should never be
      something to switch back to, and it must not stack onto the workout task.
    -->
    <activity
      android:name="expo.modules.appblocker.BlockActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleTask"
      android:noHistory="true"
      android:process=":blocker"
      android:taskAffinity="${applicationId}.blocker"
      android:theme="@style/AppBlockerTheme" />
  </application>
</manifest>
