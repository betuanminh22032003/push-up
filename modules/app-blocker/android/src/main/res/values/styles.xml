<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Dark from the first frame, so the block screen never flashes white. -->
  <style name="AppBlockerTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/app_blocker_bg</item>
    <item name="android:statusBarColor">@color/app_blocker_bg</item>
    <item name="android:navigationBarColor">@color/app_blocker_bg</item>
    <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
  </style>

  <color name="app_blocker_bg">#FF0A0A0B</color>
</resources>
